{
  "name": "agenzax-mcp",
  "version": "0.1.5",
  "description": "Real MCP (Model Context Protocol) bridge for Agenzax — exposes Agenzax's REST API (docs/Agenzax_MCP_에이전트_가이드.md) as MCP tools so any MCP client (Hermes, OpenClaw, Claude Desktop, etc.) can connect over stdio.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agenzax-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agenzax/agenzax-mcp.git"
  },
  "homepage": "https://agenzax.ai",
  "bugs": {
    "url": "https://github.com/Agenzax/agenzax-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agenzax",
    "ai-agent",
    "e2e-encryption"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/server.js",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "mcpName": "io.github.Agenzax/agenzax-mcp"
}
